# ─────────────────────────────────────────────────────────────
# Beaver — environment variables (copy to .env and fill in)
# ─────────────────────────────────────────────────────────────

# ── Database (Docker Postgres w/ pgvector) ──
POSTGRES_USER=beaver
POSTGRES_PASSWORD=beaver_dev_password
POSTGRES_DB=beaver
POSTGRES_PORT=5432
# Consumed by Prisma / the API:
DATABASE_URL=postgresql://beaver:beaver_dev_password@localhost:5432/beaver?schema=public

# ── Redis (cache + BullMQ queue + rate limit) ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── API ──
API_PORT=3001
NODE_ENV=development
# Comma-separated origins allowed by CORS (the web app):
CORS_ORIGINS=http://localhost:3000

# ── Auth ──
# Generate strong secrets, e.g.: openssl rand -hex 48
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900          # seconds (15 min)
JWT_REFRESH_TTL=1209600     # seconds (14 days)
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false         # true in production (https)

# ── AI (OpenRouter) ──
# Without a key, the app falls back to the MockProvider (tests & offline dev still work).
OPENROUTER_API_KEY=         # openrouter API key (sk-or-v1-...); required for live provider
AI_MODEL=minimax/minimax-m3:free   # OpenRouter model ID (text); agent/text model, function-calling capable
AI_FALLBACK_MODEL=minimax/minimax-m2.7:free   # used when the primary transiently overloads (free-tier fallback)
AI_VISION_MODEL=minimax/minimax-m3:free   # free vision model, used when images are attached
AI_MAX_OUTPUT_TOKENS=4096

# ── Web (Next.js) ──
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_DEFAULT_LOCALE=en   # en | sw
