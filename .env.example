# ─────────────────────────────────────────────────────────────
# Beaver — environment variables (copy to .env and fill in)
# ─────────────────────────────────────────────────────────────

# ── Database (Docker Postgres w/ pgvector) ──
POSTGRES_USER=beaver
POSTGRES_PASSWORD=beaver_dev_password
POSTGRES_DB=beaver
POSTGRES_PORT=5432
# Consumed by Prisma / the API:
DATABASE_URL=postgresql://beaver:beaver_dev_password@localhost:5432/beaver?schema=public
# Direct connection used by Prisma migrations (must bypass PgBouncer in prod).
# Without PgBouncer (local dev) it points at the same Postgres as DATABASE_URL.
DIRECT_URL=postgresql://beaver:beaver_dev_password@localhost:5432/beaver?schema=public

# ── Redis (cache + rate limit) ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── Observability (optional) ──
# SENTRY_DSN=           # e.g. https://xxxx@o123.sentry.io/456 — empty = Sentry disabled (no-op)
LOG_LEVEL=info         # trace | debug | info | warn | error

# ── Data retention (optional; 0 disables the cleanup sweep) ──
AUDIT_RETENTION_DAYS=365
MOVEMENT_RETENTION_DAYS=730

# ── API ──
API_PORT=3001
NODE_ENV=development
# Comma-separated origins allowed by CORS (the web app):
CORS_ORIGINS=http://localhost:3000

# ── Auth ──
# Generate strong secrets, e.g.: openssl rand -hex 48
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900          # seconds (15 min)
JWT_REFRESH_TTL=1209600     # seconds (14 days)
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false         # true in production (https)
COOKIE_SAMESITE=lax         # lax | none | strict — use 'none' for cross-origin PaaS deployments

# ── First platform admin (phone login) ──
# Created automatically at API startup when no platform admin exists yet.
# Use a real Tanzanian mobile: 07.., 255.. or +255.. all work.
ADMIN_PHONE=                # e.g. +255774899262
ADMIN_PASSWORD=             # min 8 chars — change immediately after first login
ADMIN_NAME=Platform Admin

# ── AI (OpenRouter) ──
# Without a key, the app falls back to the MockProvider (tests & offline dev still work).
OPENROUTER_API_KEY=         # openrouter API key (sk-or-v1-...); required for live provider
# Free-tier model slugs rotate constantly on OpenRouter (dead slugs return 404),
# so the provider resolves the live free catalog at runtime as fallback. Pick a
# currently-verified free slug below or leave the defaults.
AI_MODEL=nex-agi/nex-n2.5-pro:free         # text; agent/text model, function-calling capable
AI_FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free   # used when the primary transiently overloads
AI_VISION_MODEL=nex-agi/nex-n2.5-pro:free  # vision model, used when images are attached
AI_MAX_OUTPUT_TOKENS=4096

# ── Keepalive (Render free-tier) ──
# Render free web services spin down after ~15 min without inbound traffic, so
# the first request after idle hit a cold start. In production the API self-pings
# this public URL every KEEPALIVE_INTERVAL_MS, which counts as inbound traffic and
# stops the scale-to-zero entirely.
PUBLIC_BASE_URL=https://beaver-api-97zs.onrender.com
KEEPALIVE_INTERVAL_MS=480000

# ── Web (Next.js) ──
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_DEFAULT_LOCALE=en   # en | sw
